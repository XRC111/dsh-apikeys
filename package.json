{
  "name": "dsh-apikeys-plugin",
  "version": "1.2.0",
  "description": "Multi-platform API keys for DeepSeek Harness: keeps keys for GitHub, Cloudflare, Vercel, npm, Docker Hub, Hugging Face and custom platforms in the DSH credential store or an encrypted vault, and exposes apikey_call / apikey_platforms / apikey_key / apikey_upload so the model can call their APIs with your identity without holding the key.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./vault": "./lib/vault.js",
    "./audit": "./lib/audit.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "dsh-apikeys": "bin/cli.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "bin/*.mjs",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "api-keys",
    "credentials",
    "encrypted-vault",
    "audit-log",
    "github",
    "cloudflare",
    "vercel",
    "npm",
    "dockerhub",
    "huggingface",
    "secret-management"
  ],
  "license": "MIT",
  "author": "XRC111",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XRC111/dsh-apikeys.git"
  },
  "bugs": {
    "url": "https://github.com/XRC111/dsh-apikeys/issues"
  },
  "homepage": "https://github.com/XRC111/dsh-apikeys#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
