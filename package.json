{
  "name": "dsh-github-plugin",
  "version": "1.0.0",
  "description": "GitHub API tokens for DeepSeek Harness: a credential store for named accounts plus github_api / github_accounts / github_key tools so the model can call the GitHub REST API with the user's own token.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "github",
    "github-api",
    "api-key",
    "credentials",
    "personal-access-token"
  ],
  "license": "MIT",
  "author": "XRC111",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XRC111/dsh-github.git"
  },
  "bugs": {
    "url": "https://github.com/XRC111/dsh-github/issues"
  },
  "homepage": "https://github.com/XRC111/dsh-github#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
